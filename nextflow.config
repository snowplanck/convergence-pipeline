// =============================================================================
// Comparative Genomics Pipeline — Function-Based Convergence Detection
// Central configuration
// =============================================================================

params {
    // ---- Input ----
    input_genomes        = null            // CSV: id,path,type(fasta|genbank)
    trait_list           = null            // optional curated traits file
    outdir               = 'results'

    // ---- Module toggles ----
    run_module_0         = true            // preprocessing / gene calling
    run_module_1         = true            // dereplication
    run_module_2         = true            // homology annotation (Branch A)
    run_module_3         = true            // structure annotation (Branch B)
    run_module_4         = true            // trait matrix
    run_module_5         = true            // NISE / convergence detection
    run_module_6         = true            // clustering comparison
    run_module_7         = true            // validation

    // ---- Dereplication thresholds ----
    genome_derep_ani     = 95.0            // dRep ANI threshold
    protein_derep_id     = 95.0            // MMseqs2 protein clustering identity

    // ---- Triage / confidence thresholds ----
    homology_evalue      = 1e-5
    kofam_threshold      = 'score'         // 'score' = KO-specific threshold
    b1_confidence        = 0.9             // ProteInfer/CLEAN confidence cutoff
    b2_tmscore           = 0.5             // Foldseek TM-score cutoff
    b2_fident            = 0.3             // Foldseek sequence identity cutoff
    b3_tmscore           = 0.6             // higher bar for real 3D structures

    // ---- NISE detection ----
    nise_hhblits_prob    = 95.0            // HHblits probability threshold
    nise_mmseqs_evalue   = 1e-3            // all-vs-all homology E-value ceiling
    nise_min_tools       = 2               // min independent tools agreeing

    // ---- Clustering ----
    cluster_method       = 'apcluster'     // correlation-based affinity propagation
    mantel_permutations  = 999

    // ---- Resource defaults (overridable per-process) ----
    max_cpus             = 16
    max_memory           = '64.GB'
    max_time             = '24.h'
    gpu_enabled          = false

    // ---- Container engine ----
    engine               = 'docker'        // docker | singularity | conda
}

// ---- Profiles ----
profiles {
    standard   { includeConfig 'conf/standard.config' }
    docker     { includeConfig 'conf/docker.config' ; params.engine = 'docker' }
    singularity{ includeConfig 'conf/singularity.config' ; params.engine = 'singularity' }
    conda      { includeConfig 'conf/conda.config' ; params.engine = 'conda' }
    gpu        { includeConfig 'conf/gpu.config' ; params.gpu_enabled = true }
    test       { includeConfig 'conf/test.config' }
}

// ---- Process resource & label defaults ----
process {
    withLabel: 'cpu_low'     { cpus = 2;  memory = '4.GB';  time = '2.h' }
    withLabel: 'cpu_medium'  { cpus = 8;  memory = '16.GB'; time = '8.h' }
    withLabel: 'cpu_high'    { cpus = 16; memory = '32.GB'; time = '16.h' }
    withLabel: 'gpu_cheap'   { cpus = 4;  memory = '16.GB'; time = '4.h';  accelerator = 1 }
    withLabel: 'gpu_expensive'{ cpus = 8; memory = '32.GB'; time = '12.h'; accelerator = 1 }
    withName:  'MMSEQS_.*'   { ext.args = '-s 7.5' }
}

// ---- Reporting ----
timeline   { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report     { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace      { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag        { enabled = true; file = "${params.outdir}/pipeline_info/dag.mmap" }

manifest {
    name            = 'convergence-genomics'
    author          = 'pipeline'
    description     = 'Function-based convergence detection comparative genomics pipeline'
    nextflowVersion = '>=22.10.0'
    version         = '1.0.0'
}
